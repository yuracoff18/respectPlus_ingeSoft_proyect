# Local development only. Set your own passwords before first launch.
MONGO_ROOT_USER=respect_admin
MONGO_ROOT_PASSWORD=respect-local-admin
MONGO_APP_USER=respect_app
MONGO_APP_PASSWORD=respect-local-app
MONGO_PORT=27017
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
# Run scripts/prepare_admin_env.py to generate a strong local administrator password.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@respect.local
BOOTSTRAP_ADMIN_PASSWORD=
# Server-side provider credentials. Never use NEXT_PUBLIC_ for these values.
RIOT_API_KEY=
HENRIK_API_KEY=
FACEIT_API_KEY=
STEAM_WEB_API_KEY=
# api-fortnite.com uses x-api-key. The active Osirion rank connector needs no key.
FORTNITE_API_KEY=
